datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ContactInquiry {
  id              String   @id @default(uuid())
  name            String
  email           String
  phone           String?
  company         String?
  serviceRequired String
  budgetRange     String?
  message         String
  status          String   @default("NEW")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DiscoveryBooking {
  id            String   @id @default(uuid())
  name          String
  email         String
  company       String?
  service       String
  preferredDate String?
  preferredTime String?
  message       String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Donation {
  id                   String   @id @default(uuid())
  donorName            String?  @default("Anonymous")
  donorEmail           String?
  amount               Float
  currency             String   @default("INR")
  transactionReference String
  paymentMethod        String   @default("UPI")
  paymentStatus        String   @default("pending")
  anonymous            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model MonthlyDistribution {
  id                         String    @id @default(uuid())
  month                      String
  totalVerifiedContributions Float     @default(0)
  processingFees             Float     @default(0)
  refunds                    Float     @default(0)
  amountAvailable            Float     @default(0)
  amountDistributed          Float     @default(0)
  recipientName              String?
  recipientDetails           String?
  cause                      String?
  distributionDate           DateTime?
  documentationURL           String?
  published                  Boolean   @default(false)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}
